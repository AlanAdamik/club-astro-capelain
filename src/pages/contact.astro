---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact" description="Contactez le Club Astro Capelain pour toute question ou pour nous rejoindre.">
  <section class="stars-bg border-b border-white/10 bg-gradient-to-b from-midnight via-deep-blue to-midnight">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center sm:py-24">
      <h1 class="text-4xl font-extrabold text-white sm:text-5xl">Contact</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-300">
        Une question ? Envie de nous rejoindre ? Écrivez-nous !
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <h2 class="mb-6 text-2xl font-bold text-white">Envoyez-nous un message</h2>
        <form
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="space-y-6"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden">
            <label>
              Ne pas remplir : <input name="bot-field" />
            </label>
          </p>

          <div>
            <label for="name" class="mb-2 block text-sm font-medium text-slate-300">Nom</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full rounded-xl border border-white/10 bg-deep-blue px-4 py-3 text-white placeholder-slate-500 outline-none transition-colors focus:border-star-gold/50 focus:ring-1 focus:ring-star-gold/50"
              placeholder="Votre nom"
            />
          </div>

          <div>
            <label for="email" class="mb-2 block text-sm font-medium text-slate-300">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full rounded-xl border border-white/10 bg-deep-blue px-4 py-3 text-white placeholder-slate-500 outline-none transition-colors focus:border-star-gold/50 focus:ring-1 focus:ring-star-gold/50"
              placeholder="votre@email.fr"
            />
          </div>

          <div>
            <label for="subject" class="mb-2 block text-sm font-medium text-slate-300">Sujet</label>
            <select
              id="subject"
              name="subject"
              required
              class="w-full rounded-xl border border-white/10 bg-deep-blue px-4 py-3 text-white outline-none transition-colors focus:border-star-gold/50 focus:ring-1 focus:ring-star-gold/50"
            >
              <option value="">Choisir un sujet...</option>
              <option value="adhesion">Adhésion au club</option>
              <option value="information">Demande d'information</option>
              <option value="evenement">Question sur un événement</option>
              <option value="autre">Autre</option>
            </select>
          </div>

          <div>
            <label for="message" class="mb-2 block text-sm font-medium text-slate-300">Message</label>
            <textarea
              id="message"
              name="message"
              required
              rows="6"
              class="w-full rounded-xl border border-white/10 bg-deep-blue px-4 py-3 text-white placeholder-slate-500 outline-none transition-colors focus:border-star-gold/50 focus:ring-1 focus:ring-star-gold/50"
              placeholder="Votre message..."
            ></textarea>
          </div>

          <button
            type="submit"
            class="rounded-xl bg-star-gold px-8 py-3 text-lg font-semibold text-midnight transition-colors hover:bg-star-light"
          >
            Envoyer le message
          </button>
        </form>
      </div>

      <div>
        <h2 class="mb-6 text-2xl font-bold text-white">Informations pratiques</h2>
        <div class="space-y-6">
          <div class="rounded-2xl border border-white/10 bg-deep-blue p-6">
            <h3 class="mb-3 flex items-center gap-2 text-lg font-semibold text-white">
              <svg class="h-5 w-5 text-star-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              Lieu de réunion
            </h3>
            <p class="text-slate-400">
              Salle des fêtes de Capelain<br />
              Place de la Mairie<br />
              Capelain
            </p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-deep-blue p-6">
            <h3 class="mb-3 flex items-center gap-2 text-lg font-semibold text-white">
              <svg class="h-5 w-5 text-star-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Horaires
            </h3>
            <p class="text-slate-400">
              Réunions : tous les vendredis à 20h30<br />
              Observations : selon la météo et le calendrier
            </p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-deep-blue p-6">
            <h3 class="mb-3 flex items-center gap-2 text-lg font-semibold text-white">
              <svg class="h-5 w-5 text-star-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
              Adhésion
            </h3>
            <p class="text-slate-400">
              Cotisation annuelle : 25 €<br />
              Moins de 18 ans : 10 €<br />
              Ouvert à tous les niveaux
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
