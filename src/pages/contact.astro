---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntry, render } from "astro:content";

const page = await getEntry("pages", "contact");
const { Content } = await render(page!);
---

<BaseLayout title={page!.data.title} description={page!.data.description}>
  <section class="stars-bg border-b border-white/10 bg-gradient-to-b from-midnight via-deep-blue to-midnight">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center sm:py-24">
      <h1 class="text-4xl font-extrabold text-white sm:text-5xl">{page!.data.title}</h1>
      {page!.data.subtitle && (
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-300">
          {page!.data.subtitle}
        </p>
      )}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <h2 class="mb-6 text-2xl font-bold text-white">Envoyez-nous un message</h2>
        <form
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="space-y-6"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden">
            <label>
              Ne pas remplir : <input name="bot-field" />
            </label>
          </p>

          <div>
            <label for="name" class="mb-2 block text-sm font-medium text-slate-300">Nom</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full rounded-xl border border-white/10 bg-deep-blue px-4 py-3 text-white placeholder-slate-500 outline-none transition-colors focus:border-star-gold/50 focus:ring-1 focus:ring-star-gold/50"
              placeholder="Votre nom"
            />
          </div>

          <div>
            <label for="email" class="mb-2 block text-sm font-medium text-slate-300">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full rounded-xl border border-white/10 bg-deep-blue px-4 py-3 text-white placeholder-slate-500 outline-none transition-colors focus:border-star-gold/50 focus:ring-1 focus:ring-star-gold/50"
              placeholder="votre@email.fr"
            />
          </div>

          <div>
            <label for="subject" class="mb-2 block text-sm font-medium text-slate-300">Sujet</label>
            <select
              id="subject"
              name="subject"
              required
              class="w-full rounded-xl border border-white/10 bg-deep-blue px-4 py-3 text-white outline-none transition-colors focus:border-star-gold/50 focus:ring-1 focus:ring-star-gold/50"
            >
              <option value="">Choisir un sujet...</option>
              <option value="adhesion">Adhésion au club</option>
              <option value="information">Demande d'information</option>
              <option value="evenement">Question sur un événement</option>
              <option value="autre">Autre</option>
            </select>
          </div>

          <div>
            <label for="message" class="mb-2 block text-sm font-medium text-slate-300">Message</label>
            <textarea
              id="message"
              name="message"
              required
              rows="6"
              class="w-full rounded-xl border border-white/10 bg-deep-blue px-4 py-3 text-white placeholder-slate-500 outline-none transition-colors focus:border-star-gold/50 focus:ring-1 focus:ring-star-gold/50"
              placeholder="Votre message..."
            ></textarea>
          </div>

          <button
            type="submit"
            class="rounded-xl bg-star-gold px-8 py-3 text-lg font-semibold text-midnight transition-colors hover:bg-star-light"
          >
            Envoyer le message
          </button>
        </form>
      </div>

      <div>
        <h2 class="mb-6 text-2xl font-bold text-white">Informations pratiques</h2>
        <div class="prose contact-info">
          <Content />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-info :global(h2) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.125rem;
    padding: 1.25rem 1.5rem 0.75rem;
    margin-top: 0;
    margin-bottom: 0;
  }

  .contact-info :global(h2:not(:first-child)) {
    margin-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 1.5rem;
  }

  .contact-info :global(p) {
    padding: 0 1.5rem;
    color: #94a3b8;
    margin-bottom: 0.75rem;
  }

  .contact-info {
    border: 1px solid rgba(255, 255, 255, 0.1);
    background-color: var(--color-deep-blue);
    border-radius: 1rem;
    padding-bottom: 1.25rem;
  }
</style>
