---
import BaseLayout from "../layouts/BaseLayout.astro";
import EventCard from "../components/EventCard.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getCollection } from "astro:content";

const allEvents = await getCollection("evenements");
const upcomingEvents = allEvents
  .filter((e) => new Date(e.data.date) >= new Date())
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime())
  .slice(0, 3);

const allArticles = await getCollection("actualites");
const latestArticles = allArticles
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
---

<BaseLayout title="Accueil">
  <!-- Hero -->
  <section class="stars-bg relative overflow-hidden border-b border-white/10 bg-gradient-to-b from-midnight via-deep-blue to-midnight">
    <div class="mx-auto max-w-6xl px-4 py-24 text-center sm:py-32 lg:py-40">
      <h1 class="mb-6 text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">
        Club Astro
        <span class="text-star-gold">Capelain</span>
      </h1>
      <p class="mx-auto mb-10 max-w-2xl text-lg text-slate-300 sm:text-xl">
        Passionnés d'astronomie, nous observons le ciel depuis notre village.
        Rejoignez-nous pour découvrir les merveilles de l'univers !
      </p>
      <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="/evenements/"
          class="rounded-xl bg-star-gold px-8 py-3 text-lg font-semibold text-midnight transition-colors hover:bg-star-light"
        >
          Prochains événements
        </a>
        <a
          href="/contact/"
          class="rounded-xl border border-white/20 px-8 py-3 text-lg font-semibold text-white transition-colors hover:border-white/40 hover:bg-white/5"
        >
          Nous rejoindre
        </a>
      </div>
    </div>
  </section>

  <!-- Prochains événements -->
  {upcomingEvents.length > 0 && (
    <section class="border-b border-white/10 bg-deep-blue/30">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
        <div class="mb-10 flex items-center justify-between">
          <h2 class="text-2xl font-bold text-white sm:text-3xl">Prochains événements</h2>
          <a href="/evenements/" class="text-star-gold hover:text-star-light transition-colors font-medium">
            Tout voir &rarr;
          </a>
        </div>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {upcomingEvents.map((event) => (
            <EventCard
              title={event.data.title}
              date={event.data.date}
              heure={event.data.heure}
              lieu={event.data.lieu}
              description={event.data.description}
              slug={event.id}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Dernières actualités -->
  {latestArticles.length > 0 && (
    <section>
      <div class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
        <div class="mb-10 flex items-center justify-between">
          <h2 class="text-2xl font-bold text-white sm:text-3xl">Dernières actualités</h2>
          <a href="/actualites/" class="text-star-gold hover:text-star-light transition-colors font-medium">
            Tout voir &rarr;
          </a>
        </div>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {latestArticles.map((article) => (
            <ArticleCard
              title={article.data.title}
              date={article.data.date}
              description={article.data.description}
              slug={article.id}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
