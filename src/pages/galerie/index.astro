---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const albums = (await getCollection("galerie")).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout title="Galerie" description="Galerie photo du Club Astro Capelain — observations, soirées et événements.">
  <section class="stars-bg border-b border-white/10 bg-gradient-to-b from-midnight via-deep-blue to-midnight">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center sm:py-24">
      <h1 class="text-4xl font-extrabold text-white sm:text-5xl">Galerie</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-300">
        Les plus beaux clichés de nos observations et événements
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    {albums.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {albums.map((album) => {
          const formattedDate = new Date(album.data.date).toLocaleDateString("fr-FR", {
            month: "long",
            year: "numeric",
          });
          return (
            <a href={`/galerie/${album.id}/`} class="group overflow-hidden rounded-2xl border border-white/10 bg-deep-blue transition-all hover:border-star-gold/30">
              <div class="aspect-[16/10] overflow-hidden bg-navy/50">
                {album.data.cover && !album.data.cover.includes("placeholder") ? (
                  <img
                    src={album.data.cover}
                    alt={album.data.title}
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    loading="lazy"
                  />
                ) : (
                  <div class="flex h-full w-full items-center justify-center text-slate-600">
                    <svg class="h-20 w-20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                  </div>
                )}
              </div>
              <div class="p-5">
                <time class="text-sm text-slate-400">{formattedDate}</time>
                <h3 class="mt-1 text-lg font-bold text-white group-hover:text-star-gold transition-colors">
                  {album.data.title}
                </h3>
                <p class="mt-2 text-sm text-slate-400">{album.data.description}</p>
                <p class="mt-3 text-sm text-slate-500">{album.data.images.length} photo{album.data.images.length > 1 ? "s" : ""}</p>
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <p class="text-center text-lg text-slate-400">
        Aucun album pour le moment. Revenez bientôt !
      </p>
    )}
  </section>
</BaseLayout>
