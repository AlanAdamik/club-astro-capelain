---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GalleryGrid from "../../components/GalleryGrid.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const albums = await getCollection("galerie");
  return albums.map((album) => ({
    params: { slug: album.id },
    props: { album },
  }));
}

const { album } = Astro.props;
const { Content } = await render(album);

const formattedDate = new Date(album.data.date).toLocaleDateString("fr-FR", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<BaseLayout title={album.data.title} description={album.data.description}>
  <section class="stars-bg border-b border-white/10 bg-gradient-to-b from-midnight via-deep-blue to-midnight">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center sm:py-24">
      <time class="text-sm text-slate-400">{formattedDate}</time>
      <h1 class="mt-3 text-3xl font-extrabold text-white sm:text-4xl lg:text-5xl">
        {album.data.title}
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-300">
        {album.data.description}
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="prose mb-10">
      <Content />
    </div>

    <GalleryGrid images={album.data.images} title={album.data.title} />

    <div class="mt-12 border-t border-white/10 pt-8">
      <a href="/galerie/" class="text-star-gold hover:text-star-light transition-colors font-medium">
        &larr; Retour à la galerie
      </a>
    </div>
  </section>
</BaseLayout>
