---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EventCard from "../../components/EventCard.astro";
import { getCollection } from "astro:content";

const allEvents = await getCollection("evenements");

const now = new Date();
const upcoming = allEvents
  .filter((e) => new Date(e.data.date) >= now)
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime());

const past = allEvents
  .filter((e) => new Date(e.data.date) < now)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<BaseLayout title="Événements" description="Calendrier des événements et sorties du Club Astro Capelain.">
  <section class="stars-bg border-b border-white/10 bg-gradient-to-b from-midnight via-deep-blue to-midnight">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center sm:py-24">
      <h1 class="text-4xl font-extrabold text-white sm:text-5xl">Événements</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-300">
        Nos prochaines sorties et activités
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    {upcoming.length > 0 && (
      <div class="mb-16">
        <h2 class="mb-8 text-2xl font-bold text-white">À venir</h2>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {upcoming.map((event) => (
            <EventCard
              title={event.data.title}
              date={event.data.date}
              heure={event.data.heure}
              lieu={event.data.lieu}
              description={event.data.description}
              slug={event.id}
            />
          ))}
        </div>
      </div>
    )}

    {past.length > 0 && (
      <div>
        <h2 class="mb-8 text-2xl font-bold text-slate-400">Événements passés</h2>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 opacity-70">
          {past.map((event) => (
            <EventCard
              title={event.data.title}
              date={event.data.date}
              heure={event.data.heure}
              lieu={event.data.lieu}
              description={event.data.description}
              slug={event.id}
            />
          ))}
        </div>
      </div>
    )}

    {upcoming.length === 0 && past.length === 0 && (
      <p class="text-center text-lg text-slate-400">
        Aucun événement pour le moment. Revenez bientôt !
      </p>
    )}
  </section>
</BaseLayout>
