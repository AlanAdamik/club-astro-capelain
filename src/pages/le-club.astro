---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntry, render } from "astro:content";

const page = await getEntry("pages", "le-club");
const { Content } = await render(page!);
---

<BaseLayout title={page!.data.title} description={page!.data.description}>
  <section class="stars-bg border-b border-white/10 bg-gradient-to-b from-midnight via-deep-blue to-midnight">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center sm:py-24">
      <h1 class="text-4xl font-extrabold text-white sm:text-5xl">{page!.data.title}</h1>
      {page!.data.subtitle && (
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-300">
          {page!.data.subtitle}
        </p>
      )}
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-16">
    <div class="prose">
      <Content />
    </div>
  </section>
</BaseLayout>
