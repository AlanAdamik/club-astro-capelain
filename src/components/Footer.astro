---
const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-deep-blue">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <h3 class="mb-4 text-lg font-bold text-white">Club Astro Capelain</h3>
        <p class="text-slate-400">
          Association d'astronomie de Capelain. Observation du ciel, partage de
          connaissances et convivialité.
        </p>
      </div>

      <div>
        <h3 class="mb-4 text-lg font-bold text-white">Navigation</h3>
        <ul class="space-y-2 text-slate-400">
          <li><a href="/" class="hover:text-star-gold transition-colors">Accueil</a></li>
          <li><a href="/le-club/" class="hover:text-star-gold transition-colors">Le Club</a></li>
          <li><a href="/actualites/" class="hover:text-star-gold transition-colors">Actualités</a></li>
          <li><a href="/evenements/" class="hover:text-star-gold transition-colors">Événements</a></li>
          <li><a href="/galerie/" class="hover:text-star-gold transition-colors">Galerie</a></li>
          <li><a href="/contact/" class="hover:text-star-gold transition-colors">Contact</a></li>
        </ul>
      </div>

      <div>
        <h3 class="mb-4 text-lg font-bold text-white">Contact</h3>
        <ul class="space-y-2 text-slate-400">
          <li>Salle des fêtes de Capelain</li>
          <li>Tous les vendredis soir</li>
          <li>
            <a href="/contact/" class="text-star-gold hover:text-star-light transition-colors">
              Nous contacter
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-white/10 pt-6 text-center text-sm text-slate-500">
      &copy; {year} Club Astro Capelain. Tous droits réservés.
    </div>
  </div>
</footer>
