---
const currentPath = Astro.url.pathname;

interface NavLink {
  href: string;
  label: string;
  icon?: boolean;
}

const links: NavLink[] = [
  { href: "/", label: "Accueil" },
  { href: "/le-club/", label: "Le Club" },
  { href: "/actualites/", label: "Actualités" },
  { href: "/evenements/", label: "Événements" },
  { href: "/galerie/", label: "Galerie" },
  { href: "/contact/", label: "Contact" },
  { href: "/aide/", label: "Aide", icon: true },
];

function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-midnight/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
    <a href="/" class="flex items-center gap-3 text-xl font-bold text-white hover:text-star-gold transition-colors">
      <svg class="h-8 w-8" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
        <polygon points="32,8 36,24 52,24 39,33 43,49 32,40 21,49 25,33 12,24 28,24" fill="currentColor"/>
      </svg>
      <span class="hidden sm:inline">Club Astro Capelain</span>
      <span class="sm:hidden">CAC</span>
    </a>

    <button
      id="menu-toggle"
      class="flex items-center rounded-lg p-2 text-white hover:bg-white/10 transition-colors lg:hidden"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
    >
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path id="menu-icon-open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        <path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <nav id="nav-menu" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {links.map(({ href, label, icon }) => (
          <li>
            <a
              href={href}
              class:list={[
                "rounded-lg px-4 py-2 text-base font-medium transition-colors",
                icon && "flex items-center gap-1.5",
                isActive(href)
                  ? "bg-white/10 text-star-gold"
                  : "text-slate-300 hover:bg-white/5 hover:text-white",
              ]}
            >
              {icon && (
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              )}
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-white/10 lg:hidden">
    <ul class="mx-auto max-w-6xl space-y-1 px-4 py-4">
      {links.map(({ href, label, icon }) => (
        <li>
          <a
            href={href}
            class:list={[
              "rounded-lg px-4 py-3 text-lg font-medium transition-colors",
              icon ? "flex items-center gap-2" : "block",
              isActive(href)
                ? "bg-white/10 text-star-gold"
                : "text-slate-300 hover:bg-white/5 hover:text-white",
            ]}
          >
            {icon && (
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            )}
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle")!;
  const mobileMenu = document.getElementById("mobile-menu")!;
  const iconOpen = document.getElementById("menu-icon-open")!;
  const iconClose = document.getElementById("menu-icon-close")!;

  toggle.addEventListener("click", () => {
    const isOpen = mobileMenu.classList.toggle("hidden");
    iconOpen.classList.toggle("hidden", !isOpen);
    iconClose.classList.toggle("hidden", isOpen);
    toggle.setAttribute("aria-expanded", String(!isOpen));
  });
</script>
